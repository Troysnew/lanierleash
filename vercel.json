{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    { "path": "/api/cron/weekly", "schedule": "0 11 * * 4" },
    { "path": "/api/cron/weekly", "schedule": "0 12 * * 4" },
    { "path": "/api/cron/events", "schedule": "0 10 * * *" }
  ],
  "functions": {
    "api/cron/events.js": { "maxDuration": 120 },
    "api/admin.js": { "maxDuration": 60 }
  },
  "headers": [
    { "source": "/data/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }] }
  ]
}
