{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    { "path": "/api/cron/weekly", "schedule": "0 11 * * 4" },
    { "path": "/api/cron/weekly", "schedule": "0 12 * * 4" }
  ],
  "headers": [
    { "source": "/data/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }] }
  ]
}
