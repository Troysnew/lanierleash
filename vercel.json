{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/weekly",
      "schedule": "0 11 * * 4"
    },
    {
      "path": "/api/cron/weekly",
      "schedule": "0 12 * * 4"
    },
    {
      "path": "/api/cron/events",
      "schedule": "0 10 * * *"
    }
  ],
  "functions": {
    "api/cron/events.js": {
      "maxDuration": 120
    },
    "api/admin.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/lost-found/:id([a-z0-9-]+)/photo",
      "destination": "/api/lostfound?photo=:id"
    },
    {
      "source": "/lost-found/:id([a-z0-9-]+)",
      "destination": "/api/lostfound?page=:id"
    },
    {
      "source": "/lost-found/:id([a-z0-9-]+)/",
      "destination": "/api/lostfound?page=:id"
    },
    {
      "source": "/events.ics",
      "destination": "/api/event?feed=1"
    },
    {
      "source": "/events/:id([a-z0-9-]+)",
      "destination": "/api/event?id=:id"
    },
    {
      "source": "/events/:id([a-z0-9-]+)/",
      "destination": "/api/event?id=:id"
    },
    {
      "source": "/places/:id([a-z0-9-]+)",
      "destination": "/api/place?id=:id"
    },
    {
      "source": "/places/:id([a-z0-9-]+)/",
      "destination": "/api/place?id=:id"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/issue",
      "destination": "/api/issue"
    },
    {
      "source": "/issue/",
      "destination": "/api/issue"
    }
  ]
}
